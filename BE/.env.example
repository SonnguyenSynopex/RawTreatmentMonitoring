# SCADA / legacy REST (LAN — máy chạy BE phải ping được)
SCADA_CLEANED_URL=http://10.100.203.78:3456/api/data/cleaned
SCADA_SYSTEM_ID=raw-uf
HISTORY_BASE_URL=http://10.100.203.78:4506/api/rawuf

# Poll intervals (ms) — khớp FE cũ 5s
REALTIME_INTERVAL_MS=5000
HISTORY_INTERVAL_MS=60000
HEARTBEAT_INTERVAL_MS=5000

# HiveMQ MQTT — BE dùng TCP/TLS (KHÔNG dùng wss)
# Ví dụ: mqtts://xxxxx.s1.eu.hivemq.cloud:8883
# FE Vercel dùng: wss://xxxxx.s1.eu.hivemq.cloud:8884/mqtt  (js/mqtt-config.js)
MQTT_URL=mqtts://xxxxxxxx.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=raw-uf-bridge

# Phải khớp js/mqtt-config.js topicPrefix
MQTT_TOPIC_PREFIX=synopex/raw-uf
MQTT_QOS=1
MQTT_RETAIN=true
PUBLISH_SNAPSHOT_ALL=true
